# Opcional. Nombre mostrado en los metadatos del sitio (sin secretos).
NEXT_PUBLIC_APP_NAME=StudyFlow
# Esta versión usa una API interna y localStorage; no necesita claves de API.
# Copia este archivo a .env.local. Nunca publiques secretos en variables NEXT_PUBLIC_.
# AWS: NODE_ENV=production y NEXT_TELEMETRY_DISABLED=1 se configuran en el runtime.
# AWS_LAMBDA_HTTP_ENDPOINT lo inyecta el servicio; no establecerlo manualmente.
# NEXT_PUBLIC_APP_NAME se incorpora durante el build y requiere reconstruir para cambiarlo.
